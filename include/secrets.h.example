#pragma once

// Optional. Copy to secrets.h (gitignored) to bake in defaults; any value
// left undefined falls back to the credential-free default in
// src/config/settings.cpp. Without this file, Wi-Fi is set up on-device.

#define WIFI_SSID "YOUR_SSID"
#define WIFI_PASS "YOUR_PASS"

// Hostname (without .local) of the FluidNC controller running the plotter.
#define FLUIDNC_HOST "terrapen"

// Hostname (without .local) of the terraPixel rail-light controller.
#define TERRAPIXEL_HOST "terrapen-leds"
